{
  "name": "bootcord",
  "version": "1.0.0",
  "description": "Premium discord client alternative",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && electron .",
    "watch": "tsc -w",
    "dist": "npm run build && npx electron-builder"
  },
  "build": {
    "appId": "com.nutbrothers.bootcord",
    "productName": "bootcord",
    "compression": "maximum",
    "removePackageScripts": true,
    "publish": null,
    "asar": true,
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "src/icon.png"
    },
    "extraResources": [
      "mic.py"
    ],
    "files": [
      "dist/**/*",
      "src/renderer/**/*",
      "src/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "release"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@discordjs/voice": "^0.19.1",
    "discord.js": "^14.25.1",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "localtunnel": "^2.0.2",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5",
    "sodium-native": "^5.1.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/electron-devtools-installer": "^2.2.5",
    "@types/express": "^5.0.6",
    "@types/localtunnel": "^2.0.4",
    "@types/node": "^25.5.0",
    "@types/ws": "^8.18.1",
    "electron": "^41.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
