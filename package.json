{
  "name": "bootcord",
  "version": "1.0.1",
  "description": "Premium discord client alternative",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc && xcopy /E /I /Y src\\main\\screen-share dist\\main\\screen-share",
    "start": "npm run build && electron .",
    "watch": "tsc -w",
    "pack-unpacked": "npx electron-builder --win dir --config.win.target=dir --config.directories.output=release --config.extraResources=mic.py --config.asar=true --config.asarUnpack=\"**/node_modules/ffmpeg-static/**/*\" --config.files=dist/**/* --config.files=src/renderer/**/* --config.files=src/sounds/**/* --config.files=src/icon.png --config.files=package.json --config.appId=com.nutbrothers.bootcord --config.productName=bootcord --config.win.icon=src/icon.png",
    "release": "npm run build && npm run pack-unpacked && npm run vpk-pack",
    "vpk-pack": "node scripts/vpk-pack.mjs",
    "dist": "npm run release"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@discordjs/voice": "^0.19.1",
    "@pinggy/pinggy": "^0.4.9",
    "discord.js": "^14.25.1",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5",
    "sodium-native": "^5.1.0",
    "velopack": "^1.2.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/electron-devtools-installer": "^2.2.5",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@types/ws": "^8.18.1",
    "electron": "^41.0.2",
    "electron-builder": "^26.15.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
